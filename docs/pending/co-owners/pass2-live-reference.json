      "cmd": "SELECT",
      "qual": "((removed_at IS NULL) AND (EXISTS ( SELECT 1\n   FROM work_items w\n  WHERE ((w.id = work_item_resources.work_item_id) AND (w.kind = 'opportunity'::text) AND (w.status <> 'draft'::text) AND owner_owns_program(w.program_id)))))",
