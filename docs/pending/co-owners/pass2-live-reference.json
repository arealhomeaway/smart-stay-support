    },
    {
      "cmd": "SELECT",
      "qual": "((kind = 'opportunity'::text) AND (status <> 'draft'::text) AND (status <> 'archived'::text) AND (retired_at IS NULL) AND owner_owns_program(program_id))",
      "roles": [
        "authenticated"
      ],
      "tablename": "work_items",
      "permissive": "PERMISSIVE",
      "policyname": "Owners read their Opportunities",
      "schemaname": "public",
      "with_check": null
    },
    {
      "cmd": "SELECT",
      "qual": "(EXISTS ( SELECT 1\n   FROM (owner_reviews r\n     JOIN owner_programs p ON ((p.id = r.program_id)))\n  WHERE ((r.id = owner_request_messages.review_id) AND (p.owner_user_id = auth.uid()) AND (r.archived_at IS NULL) AND (r.status <> 'prepared'::text))))",
      "roles": [
        "authenticated"
      ],
      "tablename": "owner_request_messages",
      "permissive": "PERMISSIVE",
